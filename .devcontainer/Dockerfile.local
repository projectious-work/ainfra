# Compatibility layer for project tools that the current aibox addon catalog
# does not render. Remove this layer when projectious-work/aibox#337 restores
# the supply-chain addon.
USER root

ARG SYFT_VERSION=1.50.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) syft_arch="amd64" ;; \
      arm64) syft_arch="arm64" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    archive="syft_${SYFT_VERSION}_linux_${syft_arch}.tar.gz"; \
    release="https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}"; \
    curl -fsSL "$release/$archive" -o "/tmp/$archive"; \
    curl -fsSL "$release/syft_${SYFT_VERSION}_checksums.txt" \
      -o /tmp/syft-checksums.txt; \
    grep "  ${archive}$" /tmp/syft-checksums.txt \
      | sha256sum --check --strict; \
    tar -xzf "/tmp/$archive" -C /usr/local/bin syft; \
    rm -f "/tmp/$archive" /tmp/syft-checksums.txt; \
    syft version

USER aibox

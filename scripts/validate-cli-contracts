#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM

binary="$temporary/ainfra"
success="$temporary/version-success.json"
failure="$temporary/version-failure.json"
help="$temporary/help.json"
doctor="$temporary/doctor-environment.json"

mkdir -p "$temporary/home" "$temporary/config"

go build -o "$binary" ./cmd/ainfra
"$binary" --format json version >"$success"
"$binary" --format json help version >"$help"
HOME="$temporary/home" XDG_CONFIG_HOME="$temporary/config" \
  "$binary" --format json doctor environment >"$doctor"

for topic in ainfra doctor template init doctor.all doctor.deployment \
  doctor.template doctor.run doctor.environment template.lock \
  template.update template.migrate plan apply configure deploy output \
  inventory logs status destroy version; do
  if [ "$topic" = ainfra ]; then
    "$binary" --format json help >"$temporary/help-$topic.json"
  else
    "$binary" --format json help "$topic" >"$temporary/help-$topic.json"
  fi
done

set +e
"$binary" version --format json unexpected >"$failure"
status=$?
set -e
if [ "$status" -ne 2 ]; then
  echo "invalid version invocation returned $status, expected 2" >&2
  exit 1
fi

uv run --frozen --offline check-jsonschema \
  --schemafile spec/schemas/v1/machine-output.schema.json \
  "$temporary"/*.json

printf '%s\n' 'implemented CLI machine results conform to the v1 schema'

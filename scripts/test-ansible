#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
playbook_root="$repo_root/templates/hetzner-kubernetes-baseline/ansible"
local_tmp="${TMPDIR:-/tmp}/ainfra-ansible-local"
remote_tmp="/tmp/ainfra-ansible-remote"
ansible_home="${TMPDIR:-/tmp}/ainfra-ansible-home"

export ANSIBLE_HOME="$ansible_home"
export ANSIBLE_LOCAL_TEMP="$local_tmp"
export ANSIBLE_REMOTE_TEMP="$remote_tmp"

uv run --frozen ansible-lint "$playbook_root"
cd "$playbook_root"
uv run --frozen ansible-playbook \
  --syntax-check \
  --inventory "localhost," \
  site.yml

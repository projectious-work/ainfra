#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: scripts/verify-ansible-host INVENTORY" >&2
  exit 2
fi

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
playbook_root="$repo_root/templates/hetzner-kubernetes-baseline/ansible"
inventory=$1
local_tmp="${TMPDIR:-/tmp}/ainfra-ansible-local"
remote_tmp="/tmp/ainfra-ansible-remote"
ansible_home="${TMPDIR:-/tmp}/ainfra-ansible-home"
second_run="${TMPDIR:-/tmp}/ainfra-ansible-second-run.txt"

export ANSIBLE_HOME="$ansible_home"
export ANSIBLE_LOCAL_TEMP="$local_tmp"
export ANSIBLE_REMOTE_TEMP="$remote_tmp"

cd "$playbook_root"
uv run --frozen ansible-playbook --check --diff \
  --inventory "$inventory" site.yml
uv run --frozen ansible-playbook --inventory "$inventory" site.yml
uv run --frozen ansible-playbook --inventory "$inventory" site.yml \
  >"$second_run"

if ! grep -Eq 'changed=0[[:space:]]+unreachable=0[[:space:]]+failed=0' \
  "$second_run"; then
  cat "$second_run"
  echo "second Ansible run was not idempotent" >&2
  exit 1
fi

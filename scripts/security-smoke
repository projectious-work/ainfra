#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PATH="$repo_root/.ainfra/tools/bin:$PATH"
export PATH
temporary=$(mktemp -d "${TMPDIR:-/tmp}/ainfra-security-smoke.XXXXXX")
trap 'rm -rf "$temporary"' EXIT HUP INT TERM

cp "$repo_root/tests/fixtures/security/unsafe-public-ingress.tf" \
  "$temporary/main.tf"
checkov_report="$temporary/checkov.txt"
if checkov --directory "$temporary" --framework terraform \
  --check CKV_AWS_24 --skip-download \
  --download-external-modules false --quiet >"$checkov_report"; then
  echo "Checkov accepted deliberately unsafe public ingress" >&2
  exit 1
fi
if ! grep -q 'CKV_AWS_24' "$checkov_report"; then
  cat "$checkov_report"
  echo "Checkov failed without detecting CKV_AWS_24" >&2
  exit 1
fi

fixture_head='AKIA'
fixture_tail='Q7W8E9R0T1Y2U3I4'
fixture_label='token'
printf '%s = "%s%s"\n' "$fixture_label" "$fixture_head" "$fixture_tail" \
  >"$temporary/runtime-secret.txt"
gitleaks_report="$temporary/gitleaks.json"
if gitleaks dir --redact --no-banner --report-format json \
  --report-path "$gitleaks_report" "$temporary"; then
  echo "Gitleaks accepted a runtime-generated detector fixture" >&2
  exit 1
fi
if ! grep -q '"RuleID": "generic-api-key"' "$gitleaks_report"; then
  echo "Gitleaks failed without the expected generic-api-key finding" >&2
  exit 1
fi

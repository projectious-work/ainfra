{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/v1/roadmap.schema.json",
  "title": "ainfra roadmap data",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "note", "phases"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "summary", "status"],
              "properties": {
                "id": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
                "title": {"type": "string", "minLength": 1},
                "summary": {"type": "string", "minLength": 1},
                "status": {
                  "enum": ["idea", "planned", "in_progress", "shipped"]
                },
                "devNote": {
                  "type": "string",
                  "pattern": "^dev-notes/[a-z0-9][a-z0-9./-]*\\.md$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"status": {"const": "shipped"}},
                    "required": ["status"]
                  },
                  "then": {"required": ["devNote"]}
                }
              ]
            }
          }
        }
      }
    }
  }
}

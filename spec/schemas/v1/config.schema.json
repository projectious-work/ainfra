{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/v1/config.schema.json",
  "title": "ainfra v1 CLI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind"],
  "properties": {
    "apiVersion": {"const": "ainfra.projectious.work/v1"},
    "kind": {"const": "CLIConfig"},
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {"enum": ["text", "json"]},
        "outputStyle": {"enum": ["auto", "rich", "plain"]},
        "color": {"enum": ["auto", "always", "never"]},
        "nonInteractive": {"type": "boolean"}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["error", "warn", "info", "debug", "trace"]},
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/logDestination"}
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cache": {"type": "string", "minLength": 1},
        "runs": {"type": "string", "minLength": 1}
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tofu": {"type": "string", "minLength": 1},
        "ansibleRunner": {"type": "string", "minLength": 1},
        "git": {"type": "string", "minLength": 1},
        "ssh": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "logDestination": {
      "oneOf": [
        {"$ref": "#/$defs/stderrDestination"},
        {"$ref": "#/$defs/fileDestination"},
        {"$ref": "#/$defs/syslogDestination"}
      ]
    },
    "stderrDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "stderr"},
        "format": {"enum": ["text", "json"]}
      }
    },
    "fileDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"const": "file"},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["text", "json"]},
        "rotation": {"$ref": "#/$defs/rotation"}
      }
    },
    "syslogDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "syslog"},
        "facility": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSizeMiB": {"type": "integer", "minimum": 1},
        "maxBackups": {"type": "integer", "minimum": 0},
        "maxAgeDays": {"type": "integer", "minimum": 0},
        "compress": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/v1/template-manifest.schema.json",
  "title": "ainfra v1 template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "ainfra.projectious.work/v1"},
    "kind": {"const": "Template"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engines", "outputs"],
      "properties": {
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tofu", "ansible"],
          "properties": {
            "tofu": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directory", "version"],
              "properties": {
                "directory": {"$ref": "#/$defs/relativePath"},
                "version": {"type": "string", "minLength": 1}
              }
            },
            "ansible": {
              "type": "object",
              "additionalProperties": false,
              "required": ["directory", "playbook", "version"],
              "properties": {
                "directory": {"$ref": "#/$defs/relativePath"},
                "playbook": {"$ref": "#/$defs/relativePath"},
                "version": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventory"],
          "properties": {
            "inventory": {
              "oneOf": [
                {"const": "none"},
                {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}

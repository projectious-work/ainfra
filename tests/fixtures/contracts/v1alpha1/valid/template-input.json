{
  "apiVersion": "ainfra.projectious.work/v1alpha1",
  "kind": "TemplateInput",
  "metadata": {
    "template": "hetzner-kubernetes-baseline",
    "environment": "development",
    "disposable": true
  },
  "spec": {
    "provider": {
      "location": "fsn1",
      "projectTokenRef": {
        "type": "environment",
        "name": "HCLOUD_TOKEN"
      }
    },
    "topology": {
      "controlPlaneCount": 1,
      "workerCount": 0,
      "image": "debian-13",

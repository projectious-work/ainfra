{
  "apiVersion": "ainfra.projectious.work/v1alpha1",
  "kind": "InfrastructureOutput",
  "metadata": {
    "template": "hetzner-kubernetes-baseline",
    "templateVersion": "0.1.0",
    "environment": "development"
  },
  "spec": {
    "target": {
      "type": "kubernetes-ready",
      "name": "AINFRA_TEST_SECRET_DO_NOT_USE",
      "provider": "hetzner-cloud"
    },
    "access": {
      "ssh": {
        "hostAliases": ["control-01"],
        "transport": "private-network"
      }
    },
    "network": {
      "privateCidrs": ["10.42.0.0/16"]
    },
    "nodes": [
      {
        "name": "control-01",
        "role": "control-plane-capable",
        "privateIPv4": "10.42.0.10",
        "image": "debian-13"
      }
    ]
  }
}

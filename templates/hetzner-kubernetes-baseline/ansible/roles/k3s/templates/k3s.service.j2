[Unit]
Description=Pinned K3s initial cluster bootstrap
After=network-online.target
Wants=network-online.target

{% if inventory_hostname == groups['k3s_servers'][0] %}
{% set k3s_bootstrap_args = '--cluster-init --write-kubeconfig-mode=0600' %}
{% else %}
{% set k3s_bootstrap_args = '--server https://' ~ hostvars[groups['k3s_servers'][0]].ansible_host ~ ':6443' %}
{% endif %}
[Service]
Type=notify
Environment=K3S_TOKEN_FILE=/etc/ainfra-k3s-token
ExecStart=/usr/local/bin/k3s {{ 'server' if inventory_hostname in groups['k3s_servers'] else 'agent' }} --node-ip {{ ansible_host }} --cluster-cidr {{ k3s_cluster_cidr }} --service-cidr {{ k3s_service_cidr }} {{ k3s_bootstrap_args }}
Restart=always
RestartSec=5s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target

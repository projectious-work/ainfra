{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/template-manifest.v1alpha1.json",
  "title": "InfrastructureTemplate v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ainfra.projectious.work/v1alpha1"
    },
    "kind": {
      "const": "InfrastructureTemplate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.[0-9]+\\.[0-9]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresWrapper",
        "engines",
        "inputs",
        "output",
        "capabilities",
        "security"
      ],
      "properties": {
        "requiresWrapper": {
          "type": "string",
          "minLength": 1
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tofu", "ansible"],
          "properties": {
            "tofu": {
              "$ref": "#/$defs/engine"
            },
            "ansible": {
              "$ref": "#/$defs/engine"
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "examples"],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaPath"
            },
            "examples": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/safeRelativePath"
              }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "file"],
          "properties": {
            "schema": {
              "$ref": "#/$defs/schemaPath"
            },
            "file": {
              "$ref": "#/$defs/safeRelativePath"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requireRemoteEncryptedState",
            "prohibitGeneratedPrivateKeys",
            "prohibitRootPasswordAuthentication",
            "requirePinnedProviderVersions",
            "requirePinnedAnsibleCollections",
            "requireNoPublicManagementIngressByDefault"
          ],
          "properties": {
            "requireRemoteEncryptedState": {
              "const": true
            },
            "prohibitGeneratedPrivateKeys": {
              "const": true
            },
            "prohibitRootPasswordAuthentication": {
              "const": true
            },
            "requirePinnedProviderVersions": {
              "const": true
            },
            "requirePinnedAnsibleCollections": {
              "const": true
            },
            "requireNoPublicManagementIngressByDefault": {
              "const": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingDirectory", "minimumVersion"],
      "properties": {
        "workingDirectory": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "minimumVersion": {
          "type": "string",
          "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "schemaPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/).+\\.json$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/plan-record.v1alpha1.json",
  "title": "ainfra reviewed plan record v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "operation",
    "template",
    "template_version",
    "environment",
    "input_path",
    "input_sha256",
    "template_sha256",
    "plan_path",
    "plan_sha256"
  ],
  "properties": {
    "format_version": {
      "const": "ainfra.plan/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$"
    },
    "operation": {
      "enum": ["apply", "destroy"]
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$"
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "$ref": "#/$defs/digest"
    },
    "template_sha256": {
      "$ref": "#/$defs/digest"
    },
    "backend_config_path": {
      "type": "string",
      "minLength": 1
    },
    "backend_config_sha256": {
      "$ref": "#/$defs/digest"
    },
    "plan_path": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "dependentRequired": {
    "backend_config_path": ["backend_config_sha256"],
    "backend_config_sha256": ["backend_config_path"]
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

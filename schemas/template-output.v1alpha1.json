{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/template-output.v1alpha1.json",
  "title": "InfrastructureOutput v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ainfra.projectious.work/v1alpha1"
    },
    "kind": {
      "const": "InfrastructureOutput"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "templateVersion", "environment"],
      "properties": {
        "template": {
          "const": "hetzner-kubernetes-baseline"
        },
        "templateVersion": {
          "type": "string",
          "pattern": "^0\\.[0-9]+\\.[0-9]+$"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]+$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "access", "network", "nodes"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "provider"],
          "properties": {
            "type": {
              "const": "kubernetes-ready"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "const": "hetzner-cloud"
            },
            "credentialReference": {
              "$ref": "#/$defs/reference"
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ssh"],
          "properties": {
            "ssh": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hostAliases", "transport"],
              "properties": {
                "hostAliases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "transport": {
                  "enum": ["private-network", "tunnel"]
                }
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["privateCidrs"],
          "properties": {
            "privateCidrs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "format": "ipv4-network"
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "privateIPv4", "image"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": ["control-plane-capable", "worker"]
              },
              "privateIPv4": {
                "type": "string",
                "format": "ipv4"
              },
              "publicIPv4": {
                "type": "string",
                "format": "ipv4"
              },
              "publicIPv6": {
                "type": "string",
                "format": "ipv6"
              },
              "image": {
                "const": "debian-13"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "local-file"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.ainfra/secrets/[A-Za-z0-9._/-]+$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/template-input.v1alpha1.json",
  "title": "TemplateInput v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ainfra.projectious.work/v1alpha1"
    },
    "kind": {
      "const": "TemplateInput"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "environment", "disposable"],
      "properties": {
        "template": {
          "const": "hetzner-kubernetes-baseline"
        },
        "environment": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "disposable": {
          "type": "boolean"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "topology", "network", "access", "state"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location", "projectTokenRef"],
          "properties": {
            "location": {
              "type": "string",
              "enum": ["fsn1", "nbg1", "hel1"]
            },
            "projectTokenRef": {
              "$ref": "#/$defs/secretReference"
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controlPlaneCount",
            "workerCount",
            "image",
            "serverType"
          ],
          "properties": {
            "controlPlaneCount": {
              "const": 1
            },
            "workerCount": {
              "type": "integer",
              "minimum": 0
            },
            "image": {
              "type": "string",
              "enum": ["debian-13"],
              "description": "Supported images: debian-13 (initial default)."
            },
            "serverType": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "privateCidr",
            "publicIPv4",
            "publicIPv6",
            "managementIngressCidrs",
            "workloadIngressCidrs"
          ],
          "properties": {
            "privateCidr": {
              "type": "string",
              "format": "ipv4-network"
            },
            "publicIPv4": {
              "type": "boolean",
              "default": false
            },
            "publicIPv6": {
              "type": "boolean",
              "default": false
            },
            "managementIngressCidrs": {
              "$ref": "#/$defs/cidrs"
            },
            "workloadIngressCidrs": {
              "$ref": "#/$defs/cidrs"
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adminSshPublicKeys"],
          "properties": {
            "adminSshPublicKeys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(ssh-ed25519|sk-ssh-ed25519@openssh.com) "
              }
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["local-disposable", "remote"]
            },
            "backendConfigRef": {
              "$ref": "#/$defs/secretReference"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encryptedAtRest",
                "locking",
                "versionRecovery",
                "tls",
                "accessControl"
              ],
              "properties": {
                "encryptedAtRest": {
                  "const": true
                },
                "locking": {
                  "const": true
                },
                "versionRecovery": {
                  "const": true
                },
                "tls": {
                  "const": true
                },
                "accessControl": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "enum": ["environment", "local-file"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        }
      }
    },
    "cidrs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          {
            "format": "ipv4-network"
          },
          {
            "format": "ipv6-network"
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.projectious.work/ainfra/run-event.v1alpha1.json",
  "title": "ainfra append-only run event v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "run_id",
    "sequence",
    "stage",
    "outcome",
    "recorded_unix_nanos"
  ],
  "properties": {
    "format_version": {"const": "ainfra.run-event/v1alpha1"},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{20}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "stage": {
      "enum": [
        "planned",
        "apply",
        "output",
        "configure",
        "verify",
        "destroy",
        "destroy-verify"
      ]
    },
    "outcome": {"enum": ["started", "succeeded", "failed"]},
    "recorded_unix_nanos": {"type": "integer", "minimum": 1},
    "error_code": {"type": "string", "pattern": "^AINFRA-E[0-9]{3}$"},
    "recovery": {
      "enum": [
        "inspect-infrastructure-state",
        "inspect-output-state",
        "inspect-host-state"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "failed"}},
        "required": ["outcome"]
      },
      "then": {"required": ["error_code", "recovery"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["error_code"]},
            {"required": ["recovery"]}
          ]
        }
      }
    }
  ]
}
